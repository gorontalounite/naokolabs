# Supabase project NaokoLabs (Project Settings → API). Jangan isi dengan project Gorontalo Unite.
NEXT_PUBLIC_SUPABASE_URL=https://gcsnfqakkrorchfaemeg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sementara selama pengembangan: false = /app terbuka tanpa login (data contoh).
# Hapus saat login diaktifkan untuk klien.
AUTH_REQUIRED=false
# Server-only. Jangan pakai awalan NEXT_PUBLIC_. Dipakai untuk URL unggah/baca footage (P5).
SUPABASE_SERVICE_ROLE_KEY=
# Produksi video (P6), server-only:
GITHUB_DISPATCH_TOKEN=      # token fine-grained, izin Actions: Read and write, hanya repo naokolabs
GITHUB_WORKFLOW_REF=main    # branch tempat render.yml berada
RENDER_CODE_REF=claude      # branch kode yang dirender worker
ELEVENLABS_API_KEY=
